# Stock NX729J gatekeeper HIDL service, staged into the YARP recovery ramdisk.
# NOT started by init.recovery.qcom.rc: qseecomd owns the QSEECom channel and
# brings gatekeeper up itself once the TEE is reachable.  Starting it from
# init before qseecomd raced the TEE probe.
#
# drmrpc is added to the supplementary groups because the HAL talks to
# /dev/qseecom, which init.recovery.qcom.rc sets to 0660 system:drmrpc.
service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    class early_hal
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    seclabel u:r:recovery:s0
