<!--
    Device VINTF manifest staged in the YARP recovery ramdisk.

    This is the only manifest that declares the crypto HALs, so it replaces the
    stock fragment vendor/etc/vintf/manifest/android.hardware.security.keymint-service-qti.xml
    (which is kept in the source tree for reference but not installed).

    Declared:
      * android.hardware.security.keymint  AIDL 2.0  IKeyMintDevice/default
        (vendor/bin/hw/android.hardware.security.keymint-service-qti, stock A13)
      * android.hardware.security.keymint  AIDL 2.0  IRemotelyProvisionedComponent/default
      * android.hardware.security.sharedsecret / secureclock (same service binary)
      * android.hardware.gatekeeper       HIDL 1.0  IGatekeeper/default
        (vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti, stock A13)

    keystore2 resolves the KeyMint instance through
    binder::get_declared_instances(), which reads exactly this manifest; vold
    falls back to the HIDL gatekeeper path because no AIDL gatekeeper instance
    is declared here.
-->
<manifest version="9.0" type="device">
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>2</version>
        <fqname>IKeyMintDevice/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.keymint</name>
        <version>2</version>
        <fqname>IRemotelyProvisionedComponent/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.sharedsecret</name>
        <fqname>ISharedSecret/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.security.secureclock</name>
        <fqname>ISecureClock/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.gatekeeper</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- HIDL IBootControl@1.0/1.1/1.2 — required by TWRP's boot-hal-1-2
         (system/bin/android.hardware.boot@1.2-service, which declares all
         three interfaces). Without these entries hwservicemanager rejects
         registration and the service exits status 1, so TWRP falls back to
         the static "/dev/block/bootdevice/by-name/super" path and reports
         "Super (7) partitions | Size: 0 B" in the backup UI. -->
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.boot</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>android.hardware.boot</name>
        <fqname>IBootControl/default</fqname>
    </hal>
    <!-- HIDL IHealth@2.1 — required by TWRP's health-hal-2-1
         (system/bin/android.hardware.health@2.1-service). Without this entry
         hwservicemanager rejects registration and the HAL aborts (SIGABRT),
         so healthd never reads /sys/class/power_supply/battery and the UI
         shows a constant 100%. -->
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IHealth</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hidl.manager</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IServiceManager</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
